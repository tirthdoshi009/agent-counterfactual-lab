# Publication uses a small source allowlist. Operational outputs stay local.
/*
!/.gitignore
!/.dockerignore
!/Dockerfile
!/README.md
!/pyproject.toml
!/uv.lock
!/lab/
!/cases/
!/fixtures/
!/tests/

/lab/**
!/lab/*.py
!/lab/adapters/
!/lab/adapters/*.py
/cases/*
!/cases/scenarios.json
!/cases/counterfactual.json
/fixtures/*
!/fixtures/workspace.json
/tests/*
!/tests/*.py
!/tests/test_azure_guards.ps1

**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/provisioning-key*
**/*resource-manifest*.json
**/*.log
**/results/

